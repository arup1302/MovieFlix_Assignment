import { useCallback, useMemo } from 'react';
import { ActivityIndicator, NativeScrollEvent, NativeSyntheticEvent, Pressable, RefreshControl, ScrollView, Text, View } from 'react-native';
import { useNavigation } from '@react-navigation/native';
import { NativeStackNavigationProp } from '@react-navigation/native-stack';
import { Image } from 'expo-image';
import useMovies from '../../hooks/useMovies';
import type { Movie } from '../../types/movie';
import { HomeStackParamList } from '../../types/navigation';

export default function HomeScreen() {
  const navigation = useNavigation<NativeStackNavigationProp<HomeStackParamList, 'Home'>>();
  const { movies, loading, error, refreshing, refresh, loadMore, hasMore, loadingMore } = useMovies();

  const hero = useMemo(() => (movies && movies.length > 0 ? movies[0] : null), [movies]);
  const thrillers = useMemo(() => (movies && movies.length > 3 ? movies.slice(0, 3) : []), [movies]);
  const comedyShows = useMemo(() => (movies && movies.length > 6 ? movies.slice(3, 6) : []), [movies]);
  const crimeVault = useMemo(() => (movies && movies.length > 9 ? movies.slice(6, 9) : []), [movies]);
  const top10 = useMemo(() => (movies && movies.length > 10 ? movies.slice(0, 10) : []), [movies]);

  const handleMoviePress = useCallback((movie: Movie) => {
    navigation.navigate('Details', { movie });
  }, [navigation]);

  const onScroll = useCallback((event: NativeSyntheticEvent<NativeScrollEvent>) => {
    const { layoutMeasurement, contentOffset, contentSize } = event.nativeEvent;
    if (layoutMeasurement.height + contentOffset.y >= contentSize.height - 220) {
      if (hasMore && !loadingMore) {
        loadMore();
      }
    }
  }, [hasMore, loadingMore, loadMore]);

  const renderSection = (title: string, data: Movie[], key: string) => {
    if (!data.length) return null;

    return (
      <View key={key} className="mb-6">
        <View className="mb-3 flex-row items-center justify-between px-5">
          <Text className="text-lg font-semibold text-white">{title}</Text>
          <Text className="text-sm font-medium text-blue-400">See all</Text>
        </View>
        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ paddingHorizontal: 20 }}>
          {data.map((item, index) => (
            <Pressable key={`${key}-${item.id}-${index}`} onPress={() => handleMoviePress(item)} className="mr-4 w-40 overflow-hidden rounded-[22px] border border-white/10 bg-zinc-900">
              <Image source={item.cover} style={{ width: 160, height: 220 }} contentFit="cover" />
              <View className="px-3 py-3">
                <Text className="text-sm font-semibold text-white" numberOfLines={2}>{item.title}</Text>
                <Text className="mt-1 text-xs text-zinc-400">{item.genre.join(' • ')}</Text>
                <View className="mt-3 flex-row items-center justify-between">
                  <View className="rounded-full bg-emerald-600/90 px-2 py-1">
                    <Text className="text-[10px] font-bold text-white">★ {item.rating}</Text>
                  </View>
                  <Text className="text-xs text-zinc-400">{item.year}</Text>
                </View>
              </View>
            </Pressable>
          ))}
        </ScrollView>
      </View>
    );
  };

  if (loading && !movies.length) {
    return (
      <View className="flex-1 items-center justify-center bg-zinc-950">
        <ActivityIndicator size="large" color="#60a5fa" />
        <Text className="mt-3 text-sm text-zinc-400">Loading your movie feed…</Text>
      </View>
    );
  }

  return (
    <ScrollView
      className="flex-1 bg-zinc-950"
      contentContainerStyle={{ paddingBottom: 120 }}
      refreshControl={<RefreshControl refreshing={refreshing} onRefresh={refresh} tintColor="#fff" />}
      onScroll={onScroll}
      scrollEventThrottle={200}
    >
      <View className="px-5 pt-5">
        <View className="mb-5 flex-row items-center justify-between">
          <View>
            <Text className="text-3xl font-black text-white">MovieFlix</Text>
            <Text className="mt-1 text-sm text-zinc-400">Fresh picks for tonight</Text>
          </View>
          <View className="rounded-full border border-blue-500/40 bg-blue-500/10 px-3 py-2">
            <Text className="text-xs font-semibold text-blue-400">Live Now</Text>
          </View>
        </View>

        <View className="overflow-hidden rounded-[28px] border border-white/10 bg-zinc-900">
          {hero ? (
            <Pressable onPress={() => handleMoviePress(hero)}>
              <Image source={hero.cover} style={{ width: '100%', height: 220 }} contentFit="cover" />
              <View className="absolute inset-0 bg-black/25" />
              <View className="absolute bottom-0 left-0 right-0 p-4">
                <Text className="text-xs font-semibold uppercase tracking-[0.2em] text-blue-300">Featured</Text>
                <Text className="mt-1 text-2xl font-black text-white">{hero.title}</Text>
                <Text className="mt-1 text-sm text-zinc-200">{hero.genre.join(' • ')} • {hero.year}</Text>
              </View>
            </Pressable>
          ) : (
            <View className="h-44 items-center justify-center">
              <Text className="text-white">No featured movie yet</Text>
            </View>
          )}
        </View>
      </View>

      <View className="mt-6 px-5">
        <Text className="mb-3 text-xl font-bold text-white">Trending now</Text>
        <View className="flex-row flex-wrap justify-between">
          {top10.slice(0, 4).map((item, index) => (
            <Pressable key={`top-${item.id}`} onPress={() => handleMoviePress(item)} className="mb-4 w-[48%] overflow-hidden rounded-[20px] border border-white/10 bg-zinc-900">
              <Image source={item.cover} style={{ width: '100%', height: 140 }} contentFit="cover" />
              <View className="px-3 py-3">
                <Text className="text-sm font-semibold text-white">{index + 1}. {item.title}</Text>
                <Text className="mt-1 text-xs text-zinc-400">{item.year}</Text>
              </View>
            </Pressable>
          ))}
        </View>
      </View>

      <View className="mt-2">
        {renderSection('Thriller Movies', thrillers, 'thriller')}
        {renderSection('Comedy Shows', comedyShows, 'comedy')}
        {renderSection('Crime Vault', crimeVault, 'crime')}
      </View>

      {error ? (
        <View className="mx-5 mt-4 rounded-2xl border border-red-500/30 bg-red-500/10 p-4">
          <Text className="text-sm font-medium text-red-300">{error}</Text>
        </View>
      ) : null}

      {loadingMore ? (
        <View className="mt-4 items-center py-3">
          <ActivityIndicator size="small" color="#60a5fa" />
        </View>
      ) : null}
    </ScrollView>
  );
}
